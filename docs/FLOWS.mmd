%% Comeback Tracker — system flow diagram
%% Generated by codebase-audit, 2026-06-15
flowchart TB
    subgraph Actors
        User([User])
        Viewer([2nd user / viewer])
    end

    subgraph Browser["Browser — React PWA"]
        SW[Service Worker<br/>Workbox precache ~14.5MB]
        App[App.jsx<br/>single-atom router]
        Hook[usePersistedState<br/>state atom v5 + OCC]
        LS[(localStorage<br/>comeback-tracker-v1<br/>+ sync-meta)]
        World[WorldMode → WorldScene<br/>Three.js hub]
        Race[RaceScreen → ComebackCityThreeKartRace<br/>Three.js race + race/ engine]
        Food[FoodEntrySheet]
    end

    subgraph Edge["Cloudflare Pages Functions"]
        Access{{CF Access<br/>JWT wall}}
        Sync["/api/sync/* — me, state, backups<br/>requireAuth + OCC"]
        Fat["/api/fatsecret/* — search, item<br/>NO auth gate (S1)"]
    end

    subgraph Data
        D1[(D1<br/>user_states + state_backups)]
        OFF[OpenFoodFacts / USDA<br/>direct from browser]
        FS[FatSecret API]
    end

    User --> App
    App --> Hook
    Hook <--> LS
    App --> World
    App --> Race
    App --> Food
    SW -. precache/serve .-> App

    Hook -- "GET /me, GET/PUT /state {baseRev}" --> Access
    Access --> Sync
    Sync -- "INSERT backup; UPDATE WHERE rev=? (OCC)" --> D1
    Viewer -. "canView allowlist read" .-> Sync

    Food -- "search (q)" --> OFF
    Food -- "search/item" --> Fat
    Fat -- "OAuth2 client-creds (server secret)" --> FS

    Hook -. "deriveGameProfile: XP/level/credits<br/>from logs/food/metrics/oneRMs" .-> World
    Hook -. "deriveGameProfile + deriveRaceGarage" .-> Race

    Race -- "onFinish {trackKey, time, place}<br/>⚠ trackKey hard-coded (B2)" --> Hook

    classDef risk fill:#ffe0e0,stroke:#c0392b;
    class Fat,Race risk

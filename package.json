{
  "name": "comeback-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal training tracker PWA — The Comeback: 181 → 238 lbs",
  "scripts": {
    "dev": "vite",
    "dev:kart": "vite --config vite.config.kart.js",
    "build": "vite build",
    "build:andrew": "VITE_USER_PRESET=andrew vite build",
    "build:alexander": "VITE_USER_PRESET=alexander vite build",
    "build:kart": "vite build --config vite.config.kart.js",
    "preview": "vite preview",
    "preview:kart": "vite preview --config vite.config.kart.js",
    "test:accessibility": "node scripts/accessibility-smoke-test.mjs",
    "test:api:data": "node scripts/api-data-smoke-test.mjs",
    "test:core": "node scripts/core-tracker-smoke-test.mjs",
    "test:cross-browser": "node scripts/cross-browser-smoke-test.mjs",
    "test:device:matrix": "node scripts/device-matrix-smoke-test.mjs",
    "test:headers:deployed": "node scripts/deployed-headers-smoke-test.mjs",
    "test:lifecycle": "node scripts/page-lifecycle-audio-smoke-test.mjs",
    "test:pwa": "node scripts/header-pwa-smoke-test.mjs",
    "test:pwa:update": "node scripts/pwa-update-smoke-test.mjs",
    "test:release:smoke": "node scripts/release-smoke-test.mjs",
    "test:release:rollback": "node scripts/release-rollback-smoke-test.mjs",
    "test:release:artifacts": "node scripts/release-artifact-safety-test.mjs",
    "test:release:decisions": "node scripts/release-decision-readiness-audit.mjs",
    "test:production:gates": "node scripts/production-gate-readiness-audit.mjs",
    "test:qa:capture": "node scripts/manual-qa-capture.mjs",
    "test:monitoring:support": "node scripts/monitoring-support-readiness-audit.mjs",
    "test:security:prod": "node scripts/security-production-audit.mjs",
    "test:lab": "node scripts/lab-readiness-smoke-test.mjs",
    "test:bundle": "node scripts/bundle-asset-budget-report.mjs",
    "test:bundle:kart": "BUNDLE_BUDGET_MODE=kart node scripts/bundle-asset-budget-report.mjs",
    "test:ci:release": "node scripts/ci-release-automation-audit.mjs",
    "test:spline": "node scripts/test-spline-projection.mjs",
    "test:freebody": "node scripts/test-free-body.mjs",
    "test:laps": "node scripts/test-lap-counting.mjs",
    "test:race": "node scripts/race-content-playtest.mjs",
    "test:audio:kart": "node scripts/kart-audio-smoke-test.mjs",
    "test:kart-playable": "KART_PLAYABLE_PROOF_SERVER_SCRIPT=dev:kart node scripts/kart-playable-proof-test.mjs",
    "test:kart-playable:kart": "npm run build:kart && KART_PLAYABLE_PROOF_SERVER_SCRIPT=preview:kart node scripts/kart-playable-proof-test.mjs",
    "test:track-visuals": "node scripts/validate-track-visuals.mjs",
    "test:race-proof": "npm run build:kart && RACE_PROOF_SERVER_MODE=preview:kart npm run race:proof:capture && npm run race:proof:compare",
    "test:race-proof:kart": "npm run build:kart && RACE_PROOF_SERVER_MODE=preview:kart npm run race:proof:capture && npm run race:proof:compare",
    "test:webgl": "node scripts/webgl-context-smoke-test.mjs",
    "assets:audit": "node scripts/audit-game-assets.mjs",
    "assets:bake": "node scripts/bake-baked-glbs.mjs",
    "assets:candidates": "node scripts/build-candidate-index.mjs",
    "assets:decimate": "node scripts/blender-decimate-assets.mjs",
    "assets:gallery": "node scripts/render-asset-gallery.mjs",
    "assets:optimize": "node scripts/optimize-game-glbs.mjs",
    "assets:promote": "node scripts/promote-approved-assets.mjs",
    "assets:repair-runtime": "node scripts/repair-runtime-glb-integrity.mjs",
    "assets:validate": "node scripts/validate-game-assets.mjs",
    "assets:check": "npm run assets:audit -- --scope runtime --strict && npm run assets:validate -- --scope runtime --strict",
    "race:proof:capture": "node scripts/capture-race-proof.mjs",
    "race:proof:compare": "node scripts/compare-race-visuals.mjs",
    "deploy:andrew": "npm run build:andrew && npx wrangler pages deploy dist --project-name=comeback-andrew --branch=main --commit-dirty=true",
    "deploy:alexander": "npm run build:alexander && npx wrangler pages deploy dist --project-name=comeback-alexander --branch=main --commit-dirty=true",
    "deploy:kart:preview": "npm run build:kart && npx wrangler pages deploy dist-kart --project-name=comeback-city-kart --branch=aaa-preview --commit-dirty=true",
    "deploy:kart": "npm run build:kart && npx wrangler pages deploy dist-kart --project-name=comeback-city-kart --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "lucide-react": "^0.400.0",
    "pixi.js": "^8.19.0",
    "postprocessing": "6.39.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "~4.4.0",
    "@gltf-transform/core": "~4.4.0",
    "@gltf-transform/extensions": "~4.4.0",
    "@gltf-transform/functions": "~4.4.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "meshoptimizer": "~1.1.1",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  }
}
